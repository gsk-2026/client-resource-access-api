pipeline {
    agent any

    stages {
        stage('Verify Build') {
            steps {
                dir('client-resource-access-api') {
                    script {
                        if (isUnix()) {
                            sh 'mvn clean verify -Pqatest'
                        } else {
                            bat 'mvn clean verify -Pqatest'
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Publishing test reports...'

            junit(
                allowEmptyResults: true,
                testResults: 'target/surefire-reports/*.xml,target/failsafe-reports/*.xml'
            )

            archiveArtifacts(
                allowEmptyArchive: true,
                artifacts: 'target/gatling/**/*.html'
            )
        }

        success {
            echo 'BUILD SUCCESS'
        }

        failure {
            echo 'BUILD FAILED'
        }
    }
}