pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('*** Verify Build') {
            steps {
                dir('client-resource-access-api') {
                    bat 'build_clean_verify.bat'
                }
            }
        }
    }

    post {
        success {
            echo 'BUILD SUCCESS'
        }

        failure {
            echo 'BUILD FAILED'
        }

        always {
            echo 'Pipeline finished.'
        }
    }
}