pipeline {
    agent any

    tools {
        maven 'Maven_3_9_16'
        jdk 'JDK_26'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                if (isUnix()) {
                    sh "mvn clean compile"
                } else {
                    bat "mvn clean compile"
                }
            }
        }

        stage('Unit Test') {
            steps {
                if (isUnix()) {
                    sh "mvn test"
                } else {
                    bat "mvn test"
                }
            }
        }

        stage('Package') {
            steps {
                if (isUnix()) {
                    sh "mvn package -DskipTests"
                } else {
                    bat "mvn package -DskipTests"
                }
            }
        }

        stage('Verify Build') {
            steps {
                env.SKIP_GATLING = (env.BRANCH_NAME == 'main') ? 'false' : 'true'

                echo "Branch: ${env.BRANCH_NAME}"
                echo "Skip Gatling: ${env.SKIP_GATLING}"

                if (isUnix()) {
                    sh "mvn verify -Pqatest -DskipGatling=${env.SKIP_GATLING}"
                } else {
                    bat "mvn verify -Pqatest -DskipGatling=${env.SKIP_GATLING}"
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts(
                    artifacts: '**/target/client-resource-access-api-*.jar',
                    fingerprint: true
                )
            }
        }
    }

    post {
        always {
            echo 'Publishing test reports...'

            junit(
                allowEmptyResults: true,
                testResults: '**/target/surefire-reports/*.xml, **/target/failsafe-reports/*.xml'
            )

            archiveArtifacts(
                allowEmptyArchive: true,
                artifacts: '**/target/gatling/**'
            )

            jacoco(
                execPattern: '**/target/jacoco.exec',
                classPattern: '**/target/classes',
                sourcePattern: '**/src/main/java',
                exclusionPattern: '**/model/**, **/dto/**',

                minimumLineCoverage: '80',
                minimumClassCoverage: '80',
                minimumMethodCoverage: '80',
                minimumBranchCoverage: '70',
                minimumComplexityCoverage: '70',
                minimumInstructionCoverage: '80'
            )

            publishHTML([
                allowMissing: true,
                keepAll: true,
                alwaysLinkToLastBuild: true,
                reportDir: 'client-resource-access-api/target/site/jacoco',
                reportFiles: 'index.html',
                reportName: 'JaCoCo Coverage Report'
            ])
        }

        success {
            echo 'BUILD SUCCESS'
        }

        failure {
            echo 'BUILD FAILED'
        }
    }
}